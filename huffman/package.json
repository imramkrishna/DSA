{
  "name": "huffman-ts",
  "version": "1.0.0",
  "description": "Huffman coding file encoder/decoder in TypeScript",
  "main": "dist/cli.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "encode": "node --loader ts-node/esm src/cli.ts encode",
    "decode": "node --loader ts-node/esm src/cli.ts decode",
    "start": "node dist/cli.js"
  },
  "bin": {
    "huffman-ts": "dist/cli.js"
  },
  "keywords": [
    "huffman",
    "compression",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.19.43",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
